{{define "css"}}
    .emlang-documents {
        --diagram-bg-color: #ffffff;
		--diagram-text-color: #212529;
        --diagram-border-color: #ced4da;

        --trigger-bg-color: #e9ecef;
        --command-bg-color: #a5d8ff;
        --event-bg-color: #ffd8a8;
        --exception-bg-color: #ffc9c9;
        --view-bg-color: #b2f2bb;
        --item-border-radius: 0.5em;
        --item-width: auto;
        --item-min-width: 8em;
        --item-max-width: none;

        --diagram-font-family: system-ui;
        --props-font-family: monospace;

        --slicename-font-size: 2em;
        --slicename-font-weight: normal;
        --swimlane-font-size: 1.5em;
        --swimlane-font-weight: normal;
        --testname-font-size: 1em;
        --testname-font-weight: bold;
        --label-font-size: 0.75em;
        --label-font-weight: normal;
        --props-font-size: 0.75em;
        --props-font-weight: normal;

        align-items: flex-start;
        background-color: var(--diagram-bg-color);
        color: var(--diagram-text-color);
        display: inline-flex;
        flex-direction: column;
        gap: 2em;
    }

    .emlang-document {
        *, *:after, *:before {
            box-sizing: border-box;
        }

        display: inline-grid;
        font-family: var(--diagram-font-family), system-ui;

        .emlang-row {
            display: contents;

            & > div {
                align-items: flex-start;
                display: grid;
                gap: 1em;
                padding: 0.5em;

                &:not(:first-child) {
                    border-left: 1px solid var(--diagram-border-color);
                }
            }

            &:not(:last-child) > div {
                border-bottom: 1px solid var(--diagram-border-color);
            }

            &.emlang-row-tests > div {
                display: flex;
                flex-direction: column;
            }

            &:not(.emlang-row-tests) > div {
                grid-template-columns: subgrid;
            }
        }

        .emlang-slicename {
            font-size: var(--slicename-font-size);
            font-weight: var(--slicename-font-weight);
            grid-column: 1 / -1;
        }

        .emlang-swimlane {
            font-size: var(--swimlane-font-size);
            font-weight: var(--swimlane-font-weight);
        }

        .emlang-trigger,
        .emlang-command,
        .emlang-view,
        .emlang-event,
        .emlang-exception {
            border-radius: var(--item-border-radius);
            display: inline-flex;
            flex-direction: column;
            gap: 0.5em;
            max-width: var(--item-max-width);
            min-width: var(--item-min-width);
            padding: 0.5em;
            width: var(--item-width);
        }

        .emlang-trigger { background-color: var(--trigger-bg-color); }
        .emlang-command { background-color: var(--command-bg-color); }
        .emlang-view { background-color: var(--view-bg-color); }
        .emlang-event { background-color: var(--event-bg-color); }
        .emlang-exception { background-color: var(--exception-bg-color); }

        .emlang-props {
            column-gap: 0.5em;
            display: inline-grid;
            grid-template-columns: auto auto;
            margin: 0;

            dt:after {
                content: ': ';
            }

            * {
                font-family: var(--props-font-family), monospace;
                font-size: var(--props-font-size);
                font-weight: var(--props-font-weight);
                margin: 0;
            }
        }

        .emlang-test {
            display: inline-grid;
            gap: 1em;
            grid-template-columns: auto 1fr;

            & > span:first-child {
                font-size: var(--testname-font-size);
                font-weight: var(--testname-font-weight);
                grid-column: 1/-1;
            }

            & > span:not(:first-child) {
                font-size: var(--label-font-size);
                font-weight: var(--label-font-weight);
            }

            &:not(:last-child) {
                border-bottom: 1px solid var(--diagram-border-color);
                padding-bottom: 1em;
            }

            div {
                align-items: flex-start;
                display: flex;
                flex-direction: column;
                gap: 0.5em;
            }
        }

    }
{{end}}