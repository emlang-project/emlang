{{define "row-slicenames"}}<div class="emlang-row emlang-row-slices">
{{- if .HasSwimlanes}}
<div></div>
{{- end}}
{{- range .SliceNames}}
<div>
<span class="emlang-slicename">{{.DisplayName}}</span>
{{- if .Comment}}
<div class="emlang-comment">{{.Comment}}</div>
{{- end}}
</div>
{{- end}}
</div>{{end}}